  "cards": [
    {
      "dot": "cyan",
      "title": "Why five attempts and this backoff",
      "items": [
        "Neon free tier scales to zero after ~5 min idle; the first handshake fails while the compute resumes.",
        "Backoff min(250·2^n, 2000) sums to ≈3.75s, long enough to outlast a cold wake.",
        "Constraint violations are not matched, so genuine application errors still fail fast."
      ]
    },
    {
      "dot": "amber",
      "title": "Why it rethrows instead of returning null",
      "items": [
        "Returning null or [] would let Next.js cache a hero-less homepage for the whole 3600s window.",
        "Rethrowing aborts the ISR regeneration, so the previous good page keeps serving.",
        "getHero, getFeaturedProjects and getRecentPosts all share this contract."
      ]
    }
  ]
